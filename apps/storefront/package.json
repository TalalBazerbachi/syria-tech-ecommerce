    "@medusajs/ui-preset": "2.21.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-slider": "^1.4.7",
    "@stripe/react-stripe-js": "^5.3.0",
    "@stripe/stripe-js": "^8.2.0",
    "clsx": "^2.1.1",
    "instantsearch.js": "4.113.0",
    "lodash": "^4.17.21",
    "marked": "^18.1.1",
    "next": "15.5.24",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.438.13",
    "qs": "^6.12.1",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "react-instantsearch": "^7.46.0",
