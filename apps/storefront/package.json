    "@types/sanitize-html": "^2.16.2",
    "ansi-colors": "^4.1.3",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
