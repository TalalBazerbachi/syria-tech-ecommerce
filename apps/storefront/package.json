  "description": "Syria Tech Store storefront — Next.js 15 + Medusa 2.21, Arabic (RTL) default + English. Started from medusajs/dtc-starter.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
