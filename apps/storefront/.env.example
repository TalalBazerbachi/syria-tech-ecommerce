# --- Medusa ---------------------------------------------------------------
# Internal URL the Next.js server uses to reach Medusa (compose hostname in
# production, localhost in development).
MEDUSA_BACKEND_URL=http://localhost:9000

# URL the *browser* uses for client-side Store API calls (search, option
# filters). Leave empty in production when Caddy serves /store on the same
# origin as the storefront; set it in development where Medusa runs on 9000.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key of the storefront sales channel (Admin -> Settings ->
# Publishable API keys). Required for `next dev`.
# In the Docker image Next.js has already inlined every NEXT_PUBLIC_* value at
# build time, so there the server reads the plain runtime names instead:
# MEDUSA_PUBLISHABLE_KEY, BASE_URL, STRAPI_MEDIA_URL (set by docker-compose).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Country whose region is "the" store region. Single-country store: sy.
NEXT_PUBLIC_DEFAULT_REGION=sy

# --- Storefront -----------------------------------------------------------
# Public origin, used for absolute URLs in metadata.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default UI locale: ar (RTL) or en.
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Hostname product media is served from in production (MinIO behind Caddy).
NEXT_PUBLIC_MEDIA_HOSTNAME=

# --- Strapi (SEO content only: articles, landing pages, category/product SEO) --
# Internal URL; the browser never calls Strapi. Leave empty to disable. When
# Strapi is unreachable every page still renders without its SEO content.
STRAPI_URL=http://localhost:1337

# Optional read-only API token (custom scope: find/findOne on article,
# landing-page, category-seo, product-seo). Empty while the Public role can
# read the published entries.
STRAPI_READ_TOKEN=

# Public base for relative Strapi media URLs (only needed when uploads are
# not already absolute S3/MinIO URLs).
NEXT_PUBLIC_STRAPI_MEDIA_URL=

# The store's own WhatsApp and phone numbers, shown in the footer and on the
# checkout page (src/lib/util/contact.ts). Read at request time, so the same
# names work in Docker. Empty = that link is hidden.
STORE_WHATSAPP=
STORE_PHONE=

# How long (seconds) the storefront caches catalogue data from Medusa before
# re-fetching. Admin edits (photos, prices, stock) show up within this time.
CATALOG_REVALIDATE_SECONDS=60

# --- Analytics (PostHog, see docs/analytics.md) ---------------------------
# Project token (PostHog Cloud EU). Empty = analytics completely off: nothing
# loads, nothing is sent. `NEXT_PUBLIC_POSTHOG_KEY` serves local `next dev`;
# the Docker image is built without it, so the server reads the runtime name
# `POSTHOG_KEY` (set by docker-compose) at request time and hands it to the
# browser through <script id="ph-config"> (src/instrumentation-client.ts).
NEXT_PUBLIC_POSTHOG_KEY=

# Where the browser sends events. Empty = same-origin `/ingest`, which Caddy
# proxies to PostHog EU (our domain, so blockers don't eat events). Set it in
# development to talk to PostHog directly (https://eu.i.posthog.com) or to a
# local echo server. Runtime name: POSTHOG_HOST.
NEXT_PUBLIC_POSTHOG_HOST=

# The PostHog app, for the toolbar and links. Runtime name: POSTHOG_UI_HOST.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# `true` switches analytics off even when a key is set (no banner is shown;
# Syria has no cookie-consent law in force). Runtime name: ANALYTICS_DISABLED.
NEXT_PUBLIC_ANALYTICS_DISABLED=false
