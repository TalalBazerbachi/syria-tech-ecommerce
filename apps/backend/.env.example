# Local development WITHOUT Docker (npm run dev). In Docker everything comes from infra/.env.
# Needs a local Postgres (database `medusa`) and Redis. Leave REDIS_URL empty to fall back to
# the in-memory event bus / workflow engine (single process only).
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:5173
MEDUSA_WORKER_MODE=shared
MEDUSA_DISABLE_TELEMETRY=true
MEDUSA_FF_TRANSLATION=true

# Files -> MinIO (docker-compose.dev.yml publishes the S3 API on 127.0.0.1:9002)
S3_FILE_URL=http://localhost:9002/medusa-media
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=medusa-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=

# Dev only (set by infra/docker-compose.dev.yml): allow the admin session cookie over
# plain HTTP. Never set this on a server; production uses a Secure cookie behind Caddy TLS.
#COOKIE_SECURE=false

# Analytics (docs/analytics.md, docs/runbook.md "Analytics"). `local` logs every event through
# Medusa's logger at debug level; `posthog` sends them to PostHog Cloud EU. Unset = posthog when
# POSTHOG_EVENTS_KEY is set, local otherwise.
ANALYTICS_PROVIDER=local
# PostHog project API key (starts with phc_) and ingestion host (EU default).
POSTHOG_EVENTS_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# To see the local provider's output: LOG_LEVEL=debug must be exported in the shell (Medusa
# creates its logger before it reads this file), e.g. `LOG_LEVEL=debug npm run dev`.
