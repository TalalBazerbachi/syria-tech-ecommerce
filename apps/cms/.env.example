# Local development only. In Docker these come from infra/.env via docker-compose.
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
IS_PROXIED=false

# Secrets: generate each with `openssl rand -base64 32`
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

# Database (postgres only; sqlite is not used)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Uploads: leave S3_BUCKET empty to store files on local disk (public/uploads).
# With MinIO (docker-compose.dev.yml publishes the API on 127.0.0.1:9002):
S3_BUCKET=
S3_ENDPOINT=http://localhost:9002
S3_PUBLIC_BASE_URL=http://localhost:9002/strapi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ROOT_PATH=
S3_ACL=public-read
# Hosts the admin's CSP may load images/media from (comma-separated host[:port])
CSP_MEDIA_HOSTS=localhost:9002

# Browser origins allowed to call the REST API directly (the storefront calls server-side, so usually none)
CORS_ORIGINS=http://localhost:1337

# Public role gets find/findOne on article, landing-page, category-seo, product-seo (set false to manage manually)
STRAPI_PUBLIC_READ=true
STRAPI_TELEMETRY_DISABLED=true
FLAG_NPS=false
FLAG_PROMOTE_EE=false
