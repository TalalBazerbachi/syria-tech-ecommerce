# Copy to infra/.env and replace every placeholder. infra/.env is gitignored and lives
# only on the server (and on your machine for dev). Values below are DEV defaults where a
# default makes sense; production values are described in the comments.
#
# Generate secrets with:  openssl rand -base64 32   (APP_KEYS: four of them, comma-separated)

# ---------------------------------------------------------------- domains (production)
# Public hostnames Caddy serves. In dev these are unused (Caddyfile.dev uses *.localhost).
STORE_DOMAIN=shop.example.com
CMS_DOMAIN=cms.example.com
MEDIA_DOMAIN=media.example.com
# Let's Encrypt contact for certificate expiry notices
ACME_EMAIL=ops@example.com
# Host bind for Caddy. Prod: 80 and 443. Dev: loopback high ports (http://localhost:8080).
CADDY_HTTP_BIND=127.0.0.1:8080
CADDY_HTTPS_BIND=127.0.0.1:8443

# Dev-only: host ports published by docker-compose.dev.yml. Change one when it clashes with a
# local service (e.g. a native Postgres on 5432). Unset = the defaults listed in that file.
#DEV_POSTGRES_PORT=5432
#DEV_REDIS_PORT=6379
#DEV_MEDUSA_PORT=9000
#DEV_STRAPI_PORT=1337
#DEV_MINIO_CONSOLE_PORT=9001
#DEV_MINIO_API_PORT=9002
#DEV_STOREFRONT_PORT=8000

# ---------------------------------------------------------------- images (production)
# GitHub user/org that owns the GHCR images (lowercase). Dev builds locally and ignores this.
GHCR_OWNER=your-github-owner
# Tag to deploy: `latest` or a commit sha pushed by .github/workflows/build.yml
IMAGE_TAG=latest

# ---------------------------------------------------------------- public URLs
# Where browsers reach each app. Dev: localhost ports from docker-compose.dev.yml.
# Prod: https://${STORE_DOMAIN}, https://${CMS_DOMAIN}, https://${MEDIA_DOMAIN}
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_PUBLIC_URL=http://localhost:8000
STRAPI_PUBLIC_URL=http://localhost:1337
# Base URL of uploaded files as the browser loads them (bucket name is appended).
# Dev: the MinIO API published on 9002. Prod: https://${MEDIA_DOMAIN} (Caddy -> minio:9000).
MINIO_PUBLIC_URL=http://localhost:9002
# Where the MinIO console redirects (dev only; the console is not exposed in prod)
MINIO_CONSOLE_URL=http://localhost:9001

# ---------------------------------------------------------------- postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
MEDUSA_DB_PASSWORD=change-me
STRAPI_DB_PASSWORD=change-me

# ---------------------------------------------------------------- minio (S3-compatible files)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# Bucket per app; created public-read by docker/minio-init on every `up`
MEDUSA_S3_BUCKET=medusa-media
STRAPI_S3_BUCKET=strapi-media

# ---------------------------------------------------------------- medusa
MEDUSA_JWT_SECRET=change-me-long-random
MEDUSA_COOKIE_SECRET=change-me-long-random
# Comma-separated browser origins. Prod: STORE_CORS=https://${STORE_DOMAIN}; ADMIN/AUTH_CORS=https://${STORE_DOMAIN}
MEDUSA_STORE_CORS=http://localhost:8000,http://localhost:8080
MEDUSA_ADMIN_CORS=http://localhost:9000,http://localhost:8080
MEDUSA_AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:8080
# First admin user, created by scripts/bootstrap.sh (change the password after first login)
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=change-me
# Written by scripts/bootstrap.sh (publishable key "Storefront" from the seed). Leave empty.
MEDUSA_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- new-order alerts (Telegram)
# The worker posts every new order (number, total, customer, phone, governorate, items, admin
# link) to one Telegram chat so staff can call the customer to confirm. Both empty = no alerts.
# Bot: message @BotFather -> /newbot -> copy the token. Chat: add the bot to the staff group
# (or message it directly), send any message, then read "chat":{"id":...} from
# https://api.telegram.org/bot<token>/getUpdates (group ids are negative, e.g. -1001234567890).
ORDER_ALERT_TELEGRAM_BOT_TOKEN=
ORDER_ALERT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- analytics (PostHog)
# docs/analytics.md. Medusa (server + worker) sends "Order Completed" / "Order Cancelled" /
# "Order Delivered" / "Payment Captured" through the Analytics Module. Unset ANALYTICS_PROVIDER =
# posthog when POSTHOG_EVENTS_KEY is set, local otherwise. `local` only logs events (needs
# LOG_LEVEL=debug on the containers to be visible). The storefront's browser SDK uses the same
# key and reaches PostHog through Caddy at https://${STORE_DOMAIN}/ingest (see Caddyfile).
ANALYTICS_PROVIDER=
# PostHog Cloud EU project API key (phc_...). Public by design (the browser sends it too).
POSTHOG_EVENTS_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Medusa log level (error|warn|info|http|verbose|debug|silly). Medusa's default is `http`
# (request lines included); `debug` shows the local analytics provider's events.
LOG_LEVEL=http

# ---------------------------------------------------------------- strapi
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=change-me
STRAPI_ADMIN_JWT_SECRET=change-me
STRAPI_TRANSFER_TOKEN_SALT=change-me
STRAPI_JWT_SECRET=change-me
STRAPI_ENCRYPTION_KEY=change-me
# First Strapi admin, created by scripts/bootstrap.sh
STRAPI_ADMIN_EMAIL=admin@example.com
STRAPI_ADMIN_PASSWORD=Change-me-1
# Strapi is the SEO CMS only (articles, landing pages, category/product SEO text). It is not
# connected to Medusa: no token passes between them.

# ---------------------------------------------------------------- storefront
# The store's own numbers, shown in the footer and on the checkout page (legal pages point
# customers there). Mobiles in the local form (09XXXXXXXX) are turned into international
# links; a landline (011 ...) is dialled as written. Empty = that link is hidden.
STORE_WHATSAPP=
STORE_PHONE=
# Optional read-only Strapi API token for the storefront (custom scope: find/findOne on article,
# landing-page, category-seo, product-seo). Leave empty: the Public role already serves published
# entries of those four types, which is all the storefront needs.
STRAPI_READ_TOKEN=

# ---------------------------------------------------------------- backups (scripts/backup.sh)
# restic repository, e.g. sftp:u123456@u123456.your-storagebox.de:/backups/syria-tech
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Scratch directory on the server for dumps before they are sent to restic
BACKUP_DIR=/var/backups/syria-tech-ecommerce

# PostHog app URL for the storefront toolbar/links (browser events go through /ingest on our domain).
POSTHOG_UI_HOST=https://eu.posthog.com
# Set to true to switch the browser analytics off without removing the key.
ANALYTICS_DISABLED=
